# Banco de dados
# Local (SQLite): file:./dev.db
# Produção (Neon/Postgres): postgresql://USER:SENHA@HOST/DB?sslmode=require
DATABASE_URL="file:./dev.db"

# NextAuth — gere uma chave forte em produção
NEXTAUTH_SECRET="troque-por-uma-chave-secreta-longa"
NEXTAUTH_URL="http://localhost:3000"
# Em produção use exatamente o domínio que o aluno abre, ex:
# NEXTAUTH_URL="https://bene-curati-curso.vercel.app"
AUTH_TRUST_HOST="true"
